 "notes": [
  {
   "text": "September CPI ran hot: 3.7% a year vs 3.6% expected (+0.6% on the month, as expected). Core 2.6% vs 2.5% expected, +0.3% on the month vs +0.2%.",
   "src": "https://www.thestreet.com/stock-market-today/stock-market-today-dow-jones-sp-500-nasdaq-updates-oct-14-2026"
  },
  {
   "text": "Rate-hike bets lifted the 10-year yield about 6 bp to 5.28%, and growth and small caps paid: Nasdaq -1.88%, Russell 2000 -1.93%, while the Dow finished flat.",
   "src": "https://www.thestreet.com/stock-market-today/stock-market-today-dow-jones-sp-500-nasdaq-updates-oct-14-2026"
  },
  {
   "text": "Tech was the worst sector (-3.0%) and semis fell 4%. AI infrastructure took the hardest hits: CoreWeave -15.5%, Dell -11.3% after a Barclays downgrade to Equal Weight.",
   "src": "https://www.thestreet.com/stock-market-today/stock-market-today-dow-jones-sp-500-nasdaq-updates-oct-14-2026"
  },
  {
   "text": "Money hid in defensives: health care +2.5% and staples +2.2%, led by UnitedHealth +4.7%, Eli Lilly +3.6% and Walmart +3.5%.",
   "src": "Massive daily bars 2026-10-14"
  },
  {
   "text": "Bank earnings were mixed: BlackRock rose on a beat; Bank of America fell on a profit drop and a regulatory penalty over $1.2B; State Street fell on a revenue miss.",
   "src": "https://www.thestreet.com/stock-market-today/stock-market-today-dow-jones-sp-500-nasdaq-updates-oct-14-2026"
  }
 ],
